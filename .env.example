# Copy this file to backend/.env and fill in real values.
# Never commit the real .env file (it is gitignored).

# SQLAlchemy connection string for the bonafide Postgres database.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/bonafide

# Root directory for LocalStorageBackend document bytes.
DOCUMENT_STORAGE_PATH=../storage/documents

# Base URL the core application uses to reach the standalone AI service.
AI_SERVICE_URL=http://localhost:8100
AI_SERVICE_TIMEOUT_SECONDS=2.0

# Confidence thresholds below which AI results are routed to manual review /
# no hold is created.
AI_CONFIDENCE_THRESHOLD=0.85
LITIGATION_CONFIDENCE_THRESHOLD=0.85

# Origins the browser-based frontend is served from (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- ai_service/.env (separate process — see ai_service/.env.example) ---
# Optional: if set and reachable, the AI service uses OllamaProvider;
# otherwise it falls back to DeterministicProvider automatically.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b
