# Copy to ai_service/.env.
#
# Leave OLLAMA_BASE_URL empty (the default here) to always use
# DeterministicProvider — the safe, zero-dependency default. Uncomment the
# line below only once Ollama is actually installed and running locally;
# on some machines, a connection attempt to a configured-but-unreachable
# Ollama can take several seconds at the OS level regardless of
# OLLAMA_TIMEOUT_SECONDS, so only point this at a real running instance.
OLLAMA_BASE_URL=
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=1.0

# Image analysis (Phase 2A). "none" (the default) means every
# /analyze-image request returns 503 — the document is marked for manual
# review rather than a fabricated result. Set to "ollama" only once a real
# vision-capable model (e.g. llava, qwen2.5vl) is pulled and OLLAMA_BASE_URL
# above is uncommented and reachable.
VISION_PROVIDER=none
VISION_MODEL=llava
VISION_TIMEOUT_SECONDS=30.0
